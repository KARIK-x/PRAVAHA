# Mega Tool — environment template.
#
# Copy to `.env` (`cp .env.example .env`) and edit. `.env` is git-ignored and is
# the ONLY place secrets should live. NEVER put any value from this file into
# `web/static/*` or any Netlify build-time public variable: the frontend bundle
# is downloaded by every visitor, so anything in it is public.

# ------------------------------------------------------------------ server ---
# Bind address. Keep 127.0.0.1 so the server is reachable only from this machine.
# Do NOT set 0.0.0.0 to "share with a friend" — expose it through an authenticated
# tunnel/proxy and the friend boundary below instead.
MEGATOOL_HOST=127.0.0.1
MEGATOOL_PORT=8710

# ----------------------------------------------------------- local storage ---
# System of record (DuckDB + app SQLite) live here. Keep them on the always-on host.
# MEGATOOL_DATA_DIR=/absolute/path/to/data

# ------------------------------------------------- network defaults (Rule 5) ---
# Bounded: the app never waits indefinitely and never retries without a ceiling.
MEGATOOL_HTTP_TIMEOUT=20
MEGATOOL_HTTP_RETRIES=3
MEGATOOL_HTTP_BACKOFF=1.0
MEGATOOL_DOWNLOAD_RPS=4

# ------------------------------------------------- NEPSE official API (GATED) ---
# OFF by default. The exchange API is undocumented; automated access is an owner
# decision. Nothing — collector, benchmark or health check — contacts the host
# unless this is exactly "1".
MEGATOOL_NEPSE_API_AUTHORIZED=0

# ------------------------------------------------------- integration gate ------
# Required (with a ruling reference) before any write into the market store.
MEGATOOL_INTEGRATION_AUTHORIZED=0
MEGATOOL_INTEGRATION_RULING_REF=

# --------------------------------------------------------- source health cache -
# Where the last recorded certificate/circuit check is stored (read by /api/sources).
# MEGATOOL_HEALTH_PATH=/absolute/path/source_health.json

# --------------------------------------------------------- friend boundary -----
# Leave EMPTY for normal owner-only local use (nothing is exposed).
# Set a long random value to enable friend access; rotate by changing it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEGATOOL_FRIEND_TOKEN=

# The deployed frontend origin allowed by CORS (exact origin, no trailing slash).
# Placeholder — replace with your real Netlify site after it exists.
# MEGATOOL_FRIEND_ORIGIN=https://your-site.netlify.app

# Set to 0 to stop trusting loopback as the owner (breaks local convenience use).
MEGATOOL_FRIEND_TRUST_LOOPBACK=1

# ------------------------------------------------------- optional AI provider ---
# Not required. "" disables all AI features.
MEGATOOL_AI_PROVIDER=
MEGATOOL_AI_API_KEY=
MEGATOOL_AI_MODEL=
MEGATOOL_AI_ENDPOINT=
MEGATOOL_AI_TIMEOUT=30
MEGATOOL_AI_MAX_TOKENS=1024
OLLAMA_HOST=http://127.0.0.1:11434
